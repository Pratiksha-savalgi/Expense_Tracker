GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SPENDWISE_AI_LOG_PROMPT=1
ENABLE_RETRIEVAL_AGENT=1
ENABLE_TOOL_CALLING=1
# Set to 1 to let the assistant propose expense and budget changes.
# A change is saved only after the same user confirms it.
ENABLE_CRUD_AGENT=0
SPENDWISE_MEMORY_MAX_MESSAGES=10
SPENDWISE_MEMORY_RETENTION_DAYS=30
